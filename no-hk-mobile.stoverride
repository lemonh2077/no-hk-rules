name: OpenAI No HK
desc: OpenAI/Codex 使用自动选择的非香港节点，并直连内网数据库

proxy-groups:
  - name: NoHK-Auto
    type: url-test
    include-all: true
    filter: '(?i)^(?!.*(?:香港|HKG)).*$'
    interval: 600

rules:
  - AND,((IP-CIDR,19.25.34.81/32,no-resolve),(DST-PORT,15236)),DIRECT
  - IP-CIDR,19.25.34.81/32,DIRECT,no-resolve
  - AND,((IP-CIDR,19.25.36.128/32,no-resolve),(DST-PORT,5236)),DIRECT
  - IP-CIDR,19.25.36.128/32,DIRECT,no-resolve
  - AND,((IP-CIDR,19.15.75.180/32,no-resolve),(DST-PORT,8581)),DIRECT
  - IP-CIDR,19.15.75.180/32,DIRECT,no-resolve
  - AND,((IP-CIDR,19.25.34.84/32,no-resolve),(DST-PORT,5237)),DIRECT
  - IP-CIDR,19.25.34.84/32,DIRECT,no-resolve
  - DOMAIN-SUFFIX,openai.com,NoHK-Auto
  - DOMAIN-SUFFIX,chatgpt.com,NoHK-Auto
  - DOMAIN-SUFFIX,oaistatic.com,NoHK-Auto
  - DOMAIN-SUFFIX,oaiusercontent.com,NoHK-Auto
  - DOMAIN-SUFFIX,openaiapi-site.azureedge.net,NoHK-Auto
  - DOMAIN-SUFFIX,auth0.com,NoHK-Auto
